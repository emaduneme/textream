{
  "name": "textream-desktop",
  "productName": "Textream",
  "version": "0.1.0",
  "description": "Textream teleprompter for Windows, macOS, and Linux, built on Electron.",
  "main": "src/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.9.3",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "dev.textream.desktop",
    "productName": "Textream",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "fileAssociations": [
      {
        "ext": "textream",
        "name": "Textream Script",
        "role": "Editor"
      }
    ],
    "protocols": [
      {
        "name": "Textream",
        "schemes": [
          "textream"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Textream listens to your voice to follow your script while you read."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
